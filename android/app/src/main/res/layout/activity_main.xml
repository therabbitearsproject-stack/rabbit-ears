<?xml version="1.0" encoding="utf-8"?>
<!-- Full-screen TV: the channel edge to edge, a banner for what's on, and a side guide of channels. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#14100C"
    android:keepScreenOn="true">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="false"
        app:use_controller="false"
        app:shutter_background_color="#14100C" />

    <TextView
        android:id="@+id/msg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:padding="24dp"
        android:text="Warming up the set…"
        android:textColor="#F2E6CF"
        android:textSize="26sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#E60B0805"
        android:orientation="vertical"
        android:paddingStart="48dp"
        android:paddingTop="16dp"
        android:paddingEnd="48dp"
        android:paddingBottom="20dp"
        android:visibility="gone">
        <View android:layout_width="match_parent" android:layout_height="2dp" android:layout_marginBottom="12dp" android:background="#E8A33D" />
        <TextView android:id="@+id/bChannel" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#E8A33D" android:textSize="26sp" android:textStyle="bold" />
        <TextView android:id="@+id/bTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:maxLines="1" android:ellipsize="end" android:textColor="#F2E6CF" android:textSize="20sp" android:textStyle="bold" />
        <TextView android:id="@+id/bInfo" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:maxLines="1" android:ellipsize="end" android:textColor="#C9B99A" android:textSize="16sp" />
        <TextView android:id="@+id/bHint" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:textColor="#8F8270" android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/guide"
        android:layout_width="400dp"
        android:layout_height="match_parent"
        android:background="#F00B0805"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Channel guide" android:textColor="#E8A33D" android:textSize="26sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp"
            android:text="Everyone watching sees the same thing at the same time." android:textColor="#C9B99A" android:textSize="13sp" />
        <ListView android:id="@+id/list" android:layout_width="match_parent" android:layout_height="match_parent"
            android:divider="@null" android:choiceMode="singleChoice" android:listSelector="#66E8A33D" />
    </LinearLayout>
</FrameLayout>
