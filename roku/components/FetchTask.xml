<?xml version="1.0" encoding="utf-8"?>
<!-- Downloads one JSON file off the main thread and hands back the parsed result. -->
<component name="FetchTask" extends="Task">
  <interface>
    <field id="url" type="string" />
    <field id="tag" type="string" />
    <field id="data" type="assocarray" />
    <field id="ok" type="boolean" />
    <field id="done" type="boolean" alwaysNotify="true" />
  </interface>
  <script type="text/brightscript" uri="FetchTask.brs" />
</component>
